CONFIG_PROJECT_VERSION="1.0.1"
# 换成你在 Tuya 开发者平台创建产品后拿到的 PID（原值已移除：PID 与设备授权绑定，
# 不属于开源内容。填自己的 PID 后重新执行 tos.py build 并重新激活设备）
CONFIG_TUYA_PRODUCT_ID="YOUR_PRODUCT_ID"
CONFIG_ENABLE_UART=y
CONFIG_KWS_MODEL_PATH="~/tuyaopen_models/mdtc_chunk_300ms.mnn"
CONFIG_KWS_MODEL_TOKEN_PATH="~/tuyaopen_models/tokens.txt"
CONFIG_BOARD_CHOICE_DshanPI_A1=y
# CONFIG_ENABLE_AI_ALERT_TONE is not set
CONFIG_ENABLE_COMP_AI_AUDIO_CODEC_OPUS=y
# CONFIG_ENABLE_COMP_AI_DISPLAY is not set
CONFIG_ENABLE_AUDIO_ALSA=y
CONFIG_ALSA_DEVICE_CAPTURE="plughw:0,0"
CONFIG_ALSA_DEVICE_PLAYBACK="plughw:0,0"
