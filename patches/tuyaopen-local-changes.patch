+/* RK3576 SAI TX is hard-wired to 2 slots per LRCK frame: opening the playback
+ * stream as MONO makes the SAI drop every sample (silence) and doubles the
+ * frame accounting. Playback is always opened as STEREO and the mono stream is
+ * duplicated (mono -> L/R) inside __tdd_audio_alsa_play(). */
+#define ALSA_PLAYBACK_CHANNELS   (2)
